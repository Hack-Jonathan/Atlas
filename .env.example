# Copy this file to .env.local and fill in the values (never commit .env.local).

# Supabase project (Stage 2). Empty = not configured; the app still runs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio key for Gemini via Vercel AI SDK (Stage 6). Server-only: no NEXT_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=
